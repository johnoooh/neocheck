# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Test / Coverage
coverage/
.coverage
htmlcov/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Vendored MCP servers — exclude transient artifacts
mcp/*/node_modules
mcp/*/.git
# Pre-built JS bundles for vendored MCP servers ARE committed (overrides
# the global `dist/` rule above) so HF Gradio Spaces — which don't run a
# Dockerfile or `npm run build` — can launch them via `node dist/index.js`.
!mcp/*/dist/
!mcp/*/dist/**
